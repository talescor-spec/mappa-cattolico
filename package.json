    "@revenuecat/purchases-capacitor": "^13.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
