{
  "name": "fideora",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-legal.mjs && vite build && node scripts/generate-offline.mjs",
    "preview": "vite preview",
    "appstore:preflight": "node scripts/appstore-preflight.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --test tests/*.test.mjs",
    "appstore:release": "node scripts/release-gate.mjs",
    "build:website": "node scripts/build-website.mjs && node scripts/build-webapp.mjs",
    "build:webapp": "node scripts/build-webapp.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "8.0.3",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "@revenuecat/purchases-capacitor-ui": "^14.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react-test-renderer": "19.3.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
