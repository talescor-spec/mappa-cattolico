# Fideora environment template
#
# IMPORTANT: every VITE_* value is bundled into the browser/app and must be treated as PUBLIC.
# Never place private credentials, service-role keys, Apple private keys, or RevenueCat secret API keys in VITE_* variables.

# Client-safe values (fill only when integrations are implemented)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_REVENUECAT_PUBLIC_SDK_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=premium

# SERVER-ONLY examples — do NOT add these to this Vite client or prefix them with VITE_.
# Store them only in a trusted backend/serverless environment when that backend exists:
# SUPABASE_SERVICE_ROLE_KEY=
# REVENUECAT_SECRET_API_KEY=
# APPLE_PRIVATE_KEY=
# APPLE_KEY_ID=
# APPLE_ISSUER_ID=
